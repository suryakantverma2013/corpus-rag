{
  "realm": "corpus",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 30,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Corpus Administrator — full user mgmt, unrestricted docs (spec §4.9)"
      },
      {
        "name": "user",
        "description": "Corpus Non-Administrator — own/authorized docs only (spec §4.9)"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "corpus-backend",
      "name": "Corpus Backend (ROPC, confidential)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME_dev-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "corpus-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "corpus-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "corpus-linking",
      "name": "Corpus Account Linking (browser redirect, public + PKCE)",
      "description": "Carries ONLY the FR-AUT-11 cloud-account linking redirect. Public with PKCE because the redirect runs in the browser; it grants no API access of its own (fullScopeAllowed=false) and must never be used to log in to Corpus.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "+"
      ]
    }
  ],
  "users": [
    {
      "username": "admin@corpus.local",
      "email": "admin@corpus.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Corpus",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_admin-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ],
      "clientRoles": {
        "account": [
          "view-profile",
          "manage-account"
        ],
        "broker": [
          "read-token"
        ]
      }
    },
    {
      "username": "service-account-corpus-backend",
      "enabled": true,
      "serviceAccountClientId": "corpus-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-clients",
          "view-realm",
          "view-users"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google (Drive import)",
      "providerId": "google",
      "enabled": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "linkOnly": true,
      "config": {
        "clientId": "CHANGE_ME_google-oauth-client-id",
        "clientSecret": "CHANGE_ME_google-oauth-client-secret",
        "defaultScope": "openid email profile https://www.googleapis.com/auth/drive.readonly",
        "offlineAccess": "true",
        "prompt": "consent",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clientScopeMappings": {
    "account": [
      {
        "client": "corpus-linking",
        "roles": [
          "manage-account-links"
        ]
      }
    ]
  }
}

# Browser security headers for the SPA's browsing context (T-719, R-95, NFR-SEC-11).
#
# The extension is `.inc`, not `.conf`, for the reason proxy.inc gives: nginx auto-includes
# /etc/nginx/conf.d/*.conf at the `http` level, where a bare `add_header` outside a server
# block is a configuration error.
#
# ---------------------------------------------------------------------------------------
# WHY THIS IS AN INCLUDE AND NOT A `server`-LEVEL BLOCK, WHICH IS THE WHOLE POINT
#
# Two nginx facts combine badly here, and getting either wrong is silent.
#
# 1. `add_header` is NOT inherited into a block that defines any `add_header` of its own.
#    `location /assets/` and `location = /index.html` each set Cache-Control, so a
#    server-level policy would be silently absent from BOTH — including the one location
#    that actually serves the document (`try_files $uri /index.html` performs an internal
#    redirect, so the entry document is always handed to `location = /index.html`).
#
# 2. A server-level policy WOULD reach `location /auth/`, and Keycloak already sends its
#    own `Content-Security-Policy: frame-src 'self'; frame-ancestors 'self'; object-src
#    'none';` on its HTML pages (measured, T-719). When a browser receives two CSP headers
#    it enforces BOTH — the intersection — so ours would apply to Keycloak's login page,
#    whose inline scripts and styles are not in our hash list. That page is the FR-AUT-11
#    account-linking journey (T-214/T-512), the one browser flow this product has through
#    Keycloak, and it would break.
#
# So: included explicitly by the three locations that serve the SPA, and deliberately NOT
# by `/api/`, `/health` or `/auth/`. The API is not a browsing context — it answers fetch()
# with JSON and one image/png, and the figure route already sets its own nosniff.
#
# `always` so the headers survive an error response too; without it nginx omits them on
# anything outside 2xx/3xx.
# ---------------------------------------------------------------------------------------

# NFR-SEC-11. Every source expression here was measured against the shipped bundle in a real
# browser, not reasoned about (T-719):
#
#   default-src 'none'   Everything unlisted is denied. `object-src`, `media-src`,
#                        `worker-src`, `frame-src` and `manifest-src` all fall back to this,
#                        so they are covered without being restated.
#   script-src           'self' for /assets/index-*.js, plus ONE sha256 for the pre-paint
#                        theme script in index.html (R-58(1)). There is exactly one inline
#                        script in the shipped HTML and Vite passes it through byte for byte.
#                        The hash is regenerated by, and guarded in,
#                        backend/tests/test_security_headers.py — edit the script without
#                        updating this line and that test fails. **No 'unsafe-inline'.**
#   style-src            'self' for /assets/index-*.css; the Google origin serves the
#                        NFR-VIS-03 font stylesheet. React's `style={{…}}` props do NOT need
#                        'unsafe-inline': React writes them through the CSSOM, which CSP does
#                        not gate, while a literal style attribute stays blocked (measured
#                        both ways).
#   font-src             The woff2 files that stylesheet references.
#   img-src              'self', plus `blob:` — FR-CIT-07 fetches a figure through the
#                        authenticated route and renders an object URL, so a bare
#                        `img-src 'self'` would blank every figure with no error a user
#                        could connect to this header.
#   connect-src          'self' — every call is a relative path, and SSE goes through
#                        fetch() rather than EventSource, so it lands here too.
#   base-uri / form-action / frame-ancestors
#                        These three do not fall back to default-src and must be stated.
#                        `frame-ancestors 'none'` supersedes X-Frame-Options for the whole
#                        of BROWSER_TARGET, so that header is deliberately not sent.
#
# No report-uri/report-to: nothing collects reports, and a directive pointing at an endpoint
# that does not exist is a claim rather than a control.
add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-y75z+QjxraWj1RZWTnOWMOzabx2nQ7GTPKG55bOrwaA='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

# The API sets this on the figure route already (NFR-SEC-10); this covers the SPA's own
# assets, where a mis-typed content type would otherwise let a .css be sniffed as script.
add_header X-Content-Type-Options "nosniff" always;

# Corpus URLs carry conversation and document ids. `no-referrer` is what Keycloak sends for
# its own paths, so the whole origin behaves the same way.
add_header Referrer-Policy "no-referrer" always;

# Nothing in the product uses any of these, so denying them costs nothing and stops a future
# dependency from asking on the product's behalf.
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

# Strict-Transport-Security is deliberately NOT sent. This stack listens on plain HTTP and
# docs/DEPLOYMENT.md makes TLS the responsibility of whatever terminates it; sending HSTS
# from here would be a promise the deployment cannot keep, and an operator testing on a real
# hostname without TLS would pin their own browser away from their own deployment.

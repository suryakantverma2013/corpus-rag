# Corpus production stack — compose interpolation values (T-605).
#
#   cp deployment/.env.prod.example deployment/.env.prod
#   # fill every CHANGE_ME and OPENAI_API_KEY, then:
#   docker compose -f deployment/docker-compose.prod.yml --env-file deployment/.env.prod \
#       up -d --wait --build
#
# This file configures the STACK (ports, credentials, which URLs things answer on). The
# application's own ~29 settings groups keep their defaults; backend/.env.example documents
# the full surface if you need to override one — add it to x-corpus-env in the compose file,
# not here, since only variables referenced there are passed to a container.
#
# `deployment/.env.prod` is gitignored. This example file is committed on purpose.

# ---- public surface -------------------------------------------------------------
WEB_PORT=8088
# The origin a BROWSER uses. Feeds the FR-AUT-11 linking return URL and the corpus-linking
# client's registered redirect URIs.
PUBLIC_ORIGIN=http://localhost:8088
IMAGE_TAG=local
APP_NAME=Corpus

# ---- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=corpus
POSTGRES_USER=corpus
POSTGRES_PASSWORD=CHANGE_ME
# Keycloak gets its own role and database in the same server, created on first
# initialisation by deployment/initdb/02-keycloak-db.sh.
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ---- MinIO ----------------------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME        # MinIO requires at least 8 characters
MINIO_BUCKET=corpus

# ---- Keycloak -------------------------------------------------------------------
# Master-realm bootstrap account: for the admin console only. NOT the Corpus administrator.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Keycloak is reached by TWO different readers, and they resolve different names for it
# (R-82). The browser follows the linking redirect and carries back an `iss` claim; the API
# fetches JWKS, tokens and the admin API from inside the network.
#
#   KC_HOSTNAME / KEYCLOAK_SERVER_URL  the PUBLIC origin — what a browser uses, and what
#                                      Keycloak stamps into `iss`. These two must be
#                                      IDENTICAL, path included: Keycloak builds the claim
#                                      from KC_HOSTNAME, not from the URL the request came
#                                      in on, so a mismatch rejects every token.
#   KEYCLOAK_INTERNAL_URL              how the API reaches the same Keycloak. Optional;
#                                      empty means "same as the public URL", which is right
#                                      for a single-host deployment.
#
# Keeping the public origin on `localhost` is deliberate: browsers treat literal localhost
# as a trustworthy origin, so the Secure refresh cookie works over plain HTTP. A name that
# merely resolves to loopback does not qualify — that needs TLS.
#
# For a real deployment set all three to your own origin and terminate TLS at the edge:
#   PUBLIC_ORIGIN=https://corpus.example.com
#   KC_HOSTNAME=${PUBLIC_ORIGIN}/auth
#   KEYCLOAK_SERVER_URL=${PUBLIC_ORIGIN}/auth
#   KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KC_HOSTNAME=http://localhost:8088/auth
KEYCLOAK_SERVER_URL=http://localhost:8088/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

KEYCLOAK_REALM=corpus
KEYCLOAK_CLIENT_ID=corpus-backend
# Replaces the realm artifact's CHANGE_ME_dev-client-secret. Any long random string.
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# The Corpus administrator you actually log in as. Replaces the realm artifact's
# CHANGE_ME_admin-password. This is the value the e2e suite wants in CORPUS_PASSWORD.
CORPUS_ADMIN_EMAIL=admin@corpus.local
CORPUS_ADMIN_PASSWORD=CHANGE_ME

# Console/kcadm access only, bound to loopback.
KEYCLOAK_PORT=8180

# ---- OpenAI ---------------------------------------------------------------------
# Chat, embeddings, reranking and the evaluation judge all run through this one key.
OPENAI_API_KEY=

# ---- optional -------------------------------------------------------------------
# `structural` drops the ClamAV signature scan (and its 2 GB of RAM) while keeping the
# structural screens — magic-byte typing, macro and archive checks. There is no setting
# that disables screening altogether.
SCANNER_BACKEND=clamav
# `fake` gives deterministic vectors with no API spend; retrieval then leans on the
# lexical arm. Useful for a smoke test, wrong for a real deployment.
EMBEDDING_BACKEND=openai
LLM_BACKEND=openai

# FR-KBM-10 cloud import. Optional — the feature is off without them. These live in
# Keycloak alone; the backend never stores a third-party credential. Register
# ${PUBLIC_ORIGIN}/auth/realms/corpus/broker/google/endpoint as the authorized redirect URI
# in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openapi-typescript 7.13 still declares `peer typescript@"^5.x"` while this project is on
# TypeScript 6 (T-004). It is a build-time code *generator* — it emits a .d.ts and never runs
# in the app — and its output is verified to compile under TS 6 by `npm run build`, which
# regenerates the file before `tsc -b`. Without this flag `npm i` fails outright (T-405).
# Remove it once openapi-typescript widens the range.
legacy-peer-deps=true

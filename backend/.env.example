# Corpus backend configuration template (T-005). Copy to `.env` and fill in
# secrets:  cp backend/.env.example backend/.env
# `.env` is gitignored; this template is tracked. Defaults align with
# deployment/docker-compose.yml so the app boots with minimal edits.

# ---- Logging ----
# structlog's `cache_logger_on_first_use`. Leave true in any real deployment. Set false to
# make log output observable by anything that reconfigures structlog after import — chiefly
# `structlog.testing.capture_logs`, which the test suite relies on and which caching defeats
# permanently (a cached logger keeps the chain it was first used with, and nothing resets
# it). `tests/conftest.py` sets this false before importing the app.
LOG_CACHE_LOGGERS=true

# ---- Postgres ----
# Async DSN the app uses (developer's local pgvector-enabled `corpus` database).
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/corpus
# Individual vars — used by the compose `postgres` profile only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corpus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# ---- Object storage (T-201, R-19) ----
# Backend: `s3` (MinIO or AWS S3) or `local` (filesystem; dev only, R-19).
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=.data/objects
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_TIMEOUT_SECONDS=30

# ---- MinIO / S3 connection (used when STORAGE_BACKEND=s3) ----
# Must match wherever the compose `minio` profile is published. If another service already
# holds 9000/9001 on your machine, start it with MINIO_API_PORT/MINIO_CONSOLE_PORT and point
# this at the same port (see deployment/README.md).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=corpus
MINIO_SECURE=false
# Signing region. MinIO ignores it; botocore requires one.
MINIO_REGION=us-east-1

# ---- Uploads (T-202, FR-ERR-01/02/03) ----
# 50 MB/file and 10 GB/user are spec-normative (R-11); only the rejection copy is TBD.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_USER_QUOTA_BYTES=10737418240
UPLOAD_ENFORCE_QUOTA=true
UPLOAD_READ_CHUNK_BYTES=1048576
UPLOAD_SNIFF_HEAD_BYTES=8192
UPLOAD_MAX_CONCURRENT=8

# ---- Parsers (T-203, R-31(3) decompression caps) ----
# Worker-side ceilings on what a parser may expand an accepted original into.
# A breach fails the document (CONTENT_LIMIT_EXCEEDED); nothing is ever truncated.
PARSER_MAX_PAGES=5000
PARSER_MAX_EXTRACTED_CHARS=20000000
PARSER_MAX_BLOCK_CHARS=200000
PARSER_DOCX_MAX_EXPANDED_BYTES=419430400
PARSER_DOCX_MAX_COMPRESSION_RATIO=200
PARSER_DOCX_MAX_MEMBERS=5000
PARSER_CSV_MAX_ROWS=200000
PARSER_CSV_MAX_COLUMNS=1000
PARSER_CSV_ROWS_PER_BLOCK=50

# ---- Chunker (T-204, FR-ING-03, R-35) ----
# Retrieval-quality knobs, not limits — nothing here fails a document. All four
# compose into `chunking_version`, so changing any of them re-embeds the affected
# corpus on next ingestion (that is FR-ING-03 working, but it costs money).
CHUNKER_TARGET_CHARS=2000
CHUNKER_OVERLAP_CHARS=200
CHUNKER_MIN_CHARS=200
CHUNKER_BOUNDARY_FLOOR_RATIO=0.5

# ---- Redis (arq broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Background job queue (T-202 seam; consumed by the T-207 worker) ----
# `arq` enqueues to Redis; `none` is a no-op for dev/CI without Redis.
# There is deliberately no in-process/BackgroundTasks backend: R-31 (§8.12) requires
# parsing and scanning to happen in the worker, isolated from the API process.
QUEUE_BACKEND=arq
QUEUE_ENQUEUE_TIMEOUT_SECONDS=5

# ---- Background worker (T-207, FR-ING-04, NFR-REL-01) ----
# Run it with: uv run arq workers.main.WorkerSettings
# All values provisional — # TBD(§8.4).
# WORKER_MAX_TRIES is read twice: arq uses it, and the task reads the same value to
# detect its final attempt and write JobStatus.DEAD_LETTER itself (arq finishes an
# exhausted job without ever invoking the task, so it cannot self-report otherwise).
WORKER_MAX_TRIES=5
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_MAX_JOBS=4
# Backoff is min(base * 2**(try-1), max) with jitter, applied via arq's Retry(defer=).
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=600
# arq writes its health-check key with a TTL of heartbeat+1s; that TTL *is* the
# /health/ready/worker signal. arq's own default (3600) would make the probe useless.
WORKER_HEARTBEAT_SECONDS=30
# Sweeper for jobs T-202 committed but could not dispatch (error_code=ENQUEUE_FAILED).
WORKER_SWEEP_INTERVAL_SECONDS=300
WORKER_SWEEP_MIN_AGE_SECONDS=120
WORKER_SWEEP_BATCH_SIZE=100

# ---- Malware screening (T-207, R-31 §8.12 / R-32 §8.13) ----
# Runs at the head of the ingestion worker, before PARSING. A detection fails the job
# (FAILED + purge); an unreachable clamd fails the job *closed* (retryable) — the
# deliberate opposite of the fail-open rate limiter.
# `structural` disables only the ClamAV signature screen; the in-process structural
# checks (disguised DOCM, PDF active content) always run. Use it on a dev box that
# cannot host a ~2 GB clamd. There is no setting that disables all screening.
SCANNER_BACKEND=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_PING_TIMEOUT_SECONDS=2
CLAMAV_CHUNK_BYTES=65536
# Safety control, not tuning: clamd's 25 MB StreamMaxLength default fails OPEN by
# truncating and reporting the prefix clean, and no INSTREAM command reports the
# daemon's limit. The client refuses to stream above this, and the app refuses to boot
# if it is below UPLOAD_MAX_FILE_BYTES. Keep in step with deployment/clamav/clamd.conf.
CLAMAV_MAX_STREAM_BYTES=104857600

# ---- Rate limiting (slowapi, T-105, NFR-SEC-07) ----
# Prod uses Redis so limits are shared across workers; a distinct DB index (/1)
# keeps keys clear of the arq broker on /0. Tests force memory://. slowapi hits
# storage synchronously, so this must be the sync `redis://` scheme.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
# Provisional thresholds — # TBD(§8.4). login/refresh key per-IP; the rest per-user.
RATELIMIT_LOGIN=10/minute
RATELIMIT_REFRESH=30/minute
RATELIMIT_CHANGE_PASSWORD=5/minute
RATELIMIT_CHAT=20/minute
RATELIMIT_UPLOAD=20/minute

# ---- OpenAI (R-15) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
# Must stay 3072-dimensional to match `document_chunks.embedding` VECTOR(3072)
# (app.db.base.EMBEDDING_DIM). text-embedding-3-small is 1536-dim and will fail on
# insert. The model name is also an FR-ING-03 fingerprint input — changing it
# re-embeds the corpus. # TBD(§8.4)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---- Embeddings (T-205, FR-ING-03, R-36) ----
# How the worker drives the embeddings endpoint — batching, concurrency, transport.
# Separate from OPENAI_* (provider/account facts shared by chat and the judge).
# `fake` selects the deterministic in-process client for dev/CI; it is never chosen
# implicitly, so a missing key fails loudly instead of ingesting nonsense vectors.
EMBEDDING_BACKEND=openai
# Batch shape is bounded by request count and characters, never by `token_count`
# (R-35(7) — that is a len/4 estimate, and an underestimate is a hard 400). Ceilings
# come from the API's own limits: a 2048-item array, 300k tokens summed per request.
EMBEDDING_MAX_BATCH_SIZE=128
EMBEDDING_MAX_BATCH_CHARS=200000
EMBEDDING_MAX_CONCURRENT_REQUESTS=4
# The SDK default timeout is 600s — inside a worker that is a hang, not a timeout.
# Ingestion can ride out a rate-limit blip; a chat turn (T-206) cannot.
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_TIMEOUT_SECONDS=15
EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_MAX_RETRIES=4
EMBEDDING_QUERY_MAX_RETRIES=1

# ---- Hybrid retrieval (T-206, R-37) ----
# All # TBD(§8.4). Retrieval-quality knobs, not limits: none of them is an FR-ING-03
# fingerprint input, so all are tunable at zero re-embed cost.
# Per-arm candidate depth, fetched before fusion.
RETRIEVAL_DENSE_CANDIDATES=50
RETRIEVAL_SPARSE_CANDIDATES=50
# Reciprocal Rank Fusion damping. Large enough that one arm's rank-1 hit cannot by
# itself outrank a chunk both arms returned.
RETRIEVAL_RRF_K=60
# What hybrid search returns — the reranker's input. NOT the FR-RET-02 top-K, which
# counts reranked passages, belongs to T-306, and is still an open §8.4 TBD.
RETRIEVAL_FUSION_TOP_K=30
# pgvector's default is 40, and an HNSW scan cannot return more neighbours than its
# search list holds — leave this below RETRIEVAL_DENSE_CANDIDATES and the dense arm is
# silently truncated. Enforced by a settings validator.
RETRIEVAL_HNSW_EF_SEARCH=100
# Must match ix_document_chunks_chunk_text_fts, which indexes
# to_tsvector('english', chunk_text). Changing it without a migration that rebuilds
# that index turns every lexical search into a sequential scan — correct answers,
# unusable latency. The validator rejects any other value.
RETRIEVAL_FTS_LANGUAGE=english
# R-35(5) overlap dedupe: adjacent chunks of one block share up to CHUNKER_OVERLAP_CHARS
# and are indexed twice by FTS. A diagnostic kill switch, not a preference.
RETRIEVAL_DEDUPE_ADJACENT=true

# ---- LangGraph checkpointer (T-301, FR-PER-01, R-42) ----
# Where per-conversation graph state is persisted. `postgres` uses the SAME database as
# DATABASE_URL above (the DSN is derived from it — there is deliberately no second DSN
# setting). Its four checkpoint* tables are NOT owned by Alembic; provision them once with
#   uv run python -m app.services.checkpointer
# `memory` is dev/CI only and the app refuses to boot with it when ENVIRONMENT=production.
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=8
CHECKPOINTER_POOL_TIMEOUT_SECONDS=10
CHECKPOINTER_CONNECT_TIMEOUT_SECONDS=5
# langgraph ships strict msgpack OFF, which lets a checkpoint payload name a Python
# callable that is imported and executed on load. Our state is scalars only, so strict
# mode costs nothing.
CHECKPOINTER_STRICT_MSGPACK=true

# ---- RAG graph orchestration (T-301, FR-ORC-01/07, R-42) ----
# All # TBD(§8.4).
# The FR-ORC-07 `retry_count` bound. 1 = at most two retrieve→rerank→generate→gate
# cycles; each extra cycle roughly doubles time-to-first-token, because NFR-PRF-02 holds
# the stream until the gate passes. Settle together with the FR-RET-05 groundedness
# threshold — they trade off directly.
GRAPH_MAX_RETRIES=1
# NOT langgraph's default ("async"), under which a kill can lose the last superstep —
# the exact durability FR-PER-01/NFR-REL-03 are buying.
GRAPH_DURABILITY=sync
GRAPH_NODE_TIMEOUT_SECONDS=120
# Must admit the worst-case path, which grows with GRAPH_MAX_RETRIES; too low turns an
# FR-RET-05 abstention into a GraphRecursionError. Asserted by tests/test_graph.py.
GRAPH_RECURSION_LIMIT=25
# The R-24 processing gate (FR-STA-02 / FR-ORC-04, R-43). Lifetime of the
# `processing_locks` row the graph publishes while a turn runs; must be >=
# GRAPH_NODE_TIMEOUT_SECONDS, since a gate that cannot outlive one node is meaningless.
# The number is a trade, not a default: too short and the gate lifts during a healthy slow
# turn; too long and a crashed run pauses that user's uploads for the whole remainder.
# There is no sweeper — expiry *is* the crash release.
GRAPH_LOCK_TTL_SECONDS=180
# Diagnostic kill switch only. False stops the four mutating document routes answering
# 409; the graph still takes and releases the gate. Never a handling path for a bug.
GRAPH_LOCK_ENFORCED=true

# ---- Keycloak (auth baseline, R-28) ----
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=corpus
KEYCLOAK_CLIENT_ID=corpus-backend
KEYCLOAK_CLIENT_SECRET=
# master-realm admin — Admin API for realm bootstrap + user mgmt (python-keycloak, T-104)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME

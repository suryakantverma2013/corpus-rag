# Corpus backend configuration template (T-005). Copy to `.env` and fill in
# secrets:  cp backend/.env.example backend/.env
# `.env` is gitignored; this template is tracked. Defaults align with
# deployment/docker-compose.yml so the app boots with minimal edits.

# ---- Deployment identity ----
# READ THIS ONE BEFORE DEPLOYING. Two boot-time invariants key on the literal string
# `production` (app/config.py, Settings._coherent), and both exist to stop a deployment
# quietly losing a guarantee:
#   * CHECKPOINTER_BACKEND=memory is refused — conversations would not survive a restart.
#   * SESSION_REFRESH_COOKIE_SECURE=false is refused — the refresh token would travel in
#     clear text.
# Anything else (`development`, `staging`, …) leaves both checks dormant, so a deployment
# that never sets this is a deployment whose safety net is switched off. The production
# stack sets it in deployment/docker-compose.prod.yml; set it by hand anywhere else.
ENVIRONMENT=development
# Product name used in logs and the OpenAPI document.
APP_NAME=Corpus

# ---- Logging ----
# structlog's `cache_logger_on_first_use`. Leave true in any real deployment. Set false to
# make log output observable by anything that reconfigures structlog after import — chiefly
# `structlog.testing.capture_logs`, which the test suite relies on and which caching defeats
# permanently (a cached logger keeps the chain it was first used with, and nothing resets
# it). `tests/conftest.py` sets this false before importing the app.
LOG_CACHE_LOGGERS=true

# ---- Postgres ----
# Async DSN the app uses (developer's local pgvector-enabled `corpus` database).
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/corpus
# Individual vars — used by the compose `postgres` profile only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corpus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# ---- Object storage (T-201, R-19) ----
# Backend: `s3` (MinIO or AWS S3) or `local` (filesystem; dev only, R-19).
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=.data/objects
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_TIMEOUT_SECONDS=30

# ---- MinIO / S3 connection (used when STORAGE_BACKEND=s3) ----
# Must match wherever the compose `minio` profile is published. If another service already
# holds 9000/9001 on your machine, start it with MINIO_API_PORT/MINIO_CONSOLE_PORT and point
# this at the same port (see deployment/README.md).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=corpus
MINIO_SECURE=false
# Signing region. MinIO ignores it; botocore requires one.
MINIO_REGION=us-east-1

# ---- Uploads (T-202, FR-ERR-01/02/03) ----
# 50 MB/file and 10 GB/user are spec-normative (R-11); only the rejection copy is TBD.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_USER_QUOTA_BYTES=10737418240
UPLOAD_ENFORCE_QUOTA=true
UPLOAD_READ_CHUNK_BYTES=1048576
UPLOAD_SNIFF_HEAD_BYTES=8192
UPLOAD_MAX_CONCURRENT=8

# ---- Parsers (T-203, R-31(3) decompression caps) ----
# Worker-side ceilings on what a parser may expand an accepted original into.
# A breach fails the document (CONTENT_LIMIT_EXCEEDED); nothing is ever truncated.
PARSER_MAX_PAGES=5000
PARSER_MAX_EXTRACTED_CHARS=20000000
PARSER_MAX_BLOCK_CHARS=200000
PARSER_DOCX_MAX_EXPANDED_BYTES=419430400
PARSER_DOCX_MAX_COMPRESSION_RATIO=200
PARSER_DOCX_MAX_MEMBERS=5000
PARSER_CSV_MAX_ROWS=200000
PARSER_CSV_MAX_COLUMNS=1000
PARSER_CSV_ROWS_PER_BLOCK=50
# FR-ING-07 optical character recognition (T-217, R-88 §8.78). OFF by default: it adds a
# container, a language pack and a large latency term to every PDF ingestion, and its
# absence is a clean degradation (R-88(9)) rather than a failure — an operator who has not
# deployed the sidecar gets exactly the pre-Rev-0.55 behaviour. Turning it on requires the
# `ocr` compose service; see the OCR_* block below.
PARSER_OCR_ENABLED=false
# Recognition policy (T-218). Only read when PARSER_OCR_ENABLED=true. None of these is a
# correctness boundary — each trades recognition quality against ingestion cost — so each is
# an operator decision to settle by measurement on a real scanned corpus.
# Rasterisation resolution. Fixed rather than adaptive: recognised text feeds
# `embedding_fingerprint`, so the raster the engine sees must be a function of the page alone.
PARSER_OCR_DPI=300
# Guards the worker's memory. `get_pixmap` allocates raw samples in-process before anything
# can weigh the encoded PNG, so an unusual mediabox (A0 at 300 DPI is ~418 megapixels) would
# OOM the worker with no decoder defect involved. Over this, the render is scaled down
# deterministically rather than skipped.
PARSER_OCR_MAX_RENDER_PIXELS=40000000
# Mean word confidence, 0-100, below which a page contributes no block: a garbled quote
# damages trust in the citation mechanism itself and fills the index with tokens nobody types.
# If healthy documents cluster below it, the metric is wrong rather than the number.
PARSER_OCR_MIN_CONFIDENCE=60
# How many pages of one document may be recognised. Exceeding it is NOT a failure — the
# document ingests the pages it managed. Sized to bind before the budget below, because a
# ceiling is a deterministic function of the document and a wall clock is not.
PARSER_OCR_MAX_PAGES=200
# Whole-document recognition wall clock, checked between pages, so the worst case is
# `budget + OCR_TIMEOUT_SECONDS`. That sum must stay under WORKER_JOB_TIMEOUT_SECONDS or a
# healthy long ingestion renders as `stalled` in the knowledge-base list; the app refuses to
# boot otherwise.
PARSER_OCR_BUDGET_SECONDS=600
# An embedded raster on an otherwise-textual page is recognised only above BOTH of these:
# a fraction of the page area (from its placement box) and a native pixel dimension (from the
# stored image). Most images in a document corpus are logos and rules.
PARSER_OCR_MIN_IMAGE_AREA=0.15
PARSER_OCR_MIN_IMAGE_PIXELS=400

# ---- Chunker (T-204, FR-ING-03, R-35) ----
# Retrieval-quality knobs, not limits — nothing here fails a document. All four
# compose into `chunking_version`, so changing any of them re-embeds the affected
# corpus on next ingestion (that is FR-ING-03 working, but it costs money).
CHUNKER_TARGET_CHARS=2000
CHUNKER_OVERLAP_CHARS=200
CHUNKER_MIN_CHARS=200
CHUNKER_BOUNDARY_FLOOR_RATIO=0.5

# ---- Redis (arq broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Background job queue (T-202 seam; consumed by the T-207 worker) ----
# `arq` enqueues to Redis; `none` is a no-op for dev/CI without Redis.
# There is deliberately no in-process/BackgroundTasks backend: R-31 (§8.12) requires
# parsing and scanning to happen in the worker, isolated from the API process.
QUEUE_BACKEND=arq
QUEUE_ENQUEUE_TIMEOUT_SECONDS=5

# ---- Background worker (T-207, FR-ING-04, NFR-REL-01) ----
# Run it with: uv run arq workers.main.WorkerSettings
# All values provisional — # TBD(§8.4).
# WORKER_MAX_TRIES is read twice: arq uses it, and the task reads the same value to
# detect its final attempt and write JobStatus.DEAD_LETTER itself (arq finishes an
# exhausted job without ever invoking the task, so it cannot self-report otherwise).
WORKER_MAX_TRIES=5
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_MAX_JOBS=4
# Backoff is min(base * 2**(try-1), max) with jitter, applied via arq's Retry(defer=).
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=600
# arq writes its health-check key with a TTL of heartbeat+1s; that TTL *is* the
# /health/ready/worker signal. arq's own default (3600) would make the probe useless.
WORKER_HEARTBEAT_SECONDS=30
# Sweeper for jobs T-202 committed but could not dispatch (error_code=ENQUEUE_FAILED).
WORKER_SWEEP_INTERVAL_SECONDS=300
WORKER_SWEEP_MIN_AGE_SECONDS=120
WORKER_SWEEP_BATCH_SIZE=100

# ---- Malware screening (T-207, R-31 §8.12 / R-32 §8.13) ----
# Runs at the head of the ingestion worker, before PARSING. A detection fails the job
# (FAILED + purge); an unreachable clamd fails the job *closed* (retryable) — the
# deliberate opposite of the fail-open rate limiter.
# `structural` disables only the ClamAV signature screen; the in-process structural
# checks (disguised DOCM, PDF active content) always run. Use it on a dev box that
# cannot host a ~2 GB clamd. There is no setting that disables all screening.
SCANNER_BACKEND=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_PING_TIMEOUT_SECONDS=2
CLAMAV_CHUNK_BYTES=65536
# Safety control, not tuning: clamd's 25 MB StreamMaxLength default fails OPEN by
# truncating and reporting the prefix clean, and no INSTREAM command reports the
# daemon's limit. The client refuses to stream above this, and the app refuses to boot
# if it is below UPLOAD_MAX_FILE_BYTES. Keep in step with deployment/clamav/clamd.conf.
CLAMAV_MAX_STREAM_BYTES=104857600

# ---- OCR sidecar (T-217, R-88 §8.78, FR-ING-07 / NFR-SEC-09) ----
# Only reached when PARSER_OCR_ENABLED=true. Recognition runs outside the worker process
# because it renders attacker-supplied content; the worker rasterises and sends a PNG, and
# nothing leaves the deployment. Start it with:
#   docker compose -f deployment/docker-compose.yml --profile ocr up -d --build
# There is deliberately no OCR_BACKEND: R-88(1) refuses a pluggable recogniser, because the
# alternative vendor class is excluded on determinism grounds.
OCR_HOST=localhost
OCR_PORT=8884
OCR_TIMEOUT_SECONDS=60
OCR_PING_TIMEOUT_SECONDS=2
# Refused before the request is made; the sidecar enforces the same ceiling itself.
OCR_MAX_IMAGE_BYTES=33554432
# Tesseract's own syntax ('eng', 'eng+deu'). The pack must be present in the sidecar image
# or its tessdata volume — `GET /health` on the sidecar lists what it loaded.
OCR_LANGUAGES=eng

# ---- Rate limiting (slowapi, T-105, NFR-SEC-07) ----
# Prod uses Redis so limits are shared across workers; a distinct DB index (/1)
# keeps keys clear of the arq broker on /0. Tests force memory://. slowapi hits
# storage synchronously, so this must be the sync `redis://` scheme.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
# Provisional thresholds — # TBD(§8.4). login/refresh key per-IP; the rest per-user.
RATELIMIT_LOGIN=10/minute
RATELIMIT_REFRESH=30/minute
RATELIMIT_CHANGE_PASSWORD=5/minute
RATELIMIT_CHAT=20/minute
RATELIMIT_UPLOAD=20/minute

# ---- OpenAI (R-15) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
# The FR-RET-03 router (T-304). Deliberately not OPENAI_CHAT_MODEL: it emits a few tokens
# of JSON on the critical path before retrieval, so it wants the cheapest model that can
# follow a schema, while the chat model is chosen for answer quality. # TBD(§8.4)
OPENAI_ROUTER_MODEL=gpt-4o-mini
# The FR-RET-02 reranker (T-306, R-47). Same reasoning as the router — a cheap, fast
# schema-follower — but a separate knob, because the two are tuned against different
# evidence (classification accuracy vs ranking quality). # TBD(§8.4)
OPENAI_RERANK_MODEL=gpt-4o-mini
# The FR-EVL-01 DeepEval judge (T-309, R-50). The first model id whose call site is off the
# request path entirely — it runs post-hoc in the worker, so five judge calls per message cost
# patience rather than latency.
# Raised from gpt-4o-mini on 2026-08-02 (Rev 0.20.1): the cheap judge scored a verbatim
# restatement of the passage it cited at 0.33-0.67 against a realistic 8-passage grounding set
# where this one scores 1.00, and FR-EVL-02 shows that number to a user. Better on balance
# (six chips corrected, two regressed) — not an oracle; see OI-35.
OPENAI_JUDGE_MODEL=gpt-4o
# T-314 two-tier judging: the stronger model that re-scores a chip coming back below
# EVAL_ESCALATE_BELOW. Measured, not assumed — on T-312's golden set gpt-4o-mini scores a
# verbatim-grounded answer 0.33-0.67 (once 0.00) against a realistic 8-passage grounding set
# where gpt-4o scores it 1.00, and FR-EVL-02 renders that number to a user.
# Equal to OPENAI_JUDGE_MODEL above, so escalation is DORMANT — the second tier is skipped
# when both name the same model. Set OPENAI_JUDGE_MODEL back to gpt-4o-mini to re-arm it.
OPENAI_JUDGE_ESCALATION_MODEL=gpt-4o
# Must stay 3072-dimensional to match `document_chunks.embedding` VECTOR(3072)
# (app.db.base.EMBEDDING_DIM). text-embedding-3-small is 1536-dim and will fail on
# insert. The model name is also an FR-ING-03 fingerprint input — changing it
# re-embeds the corpus. # TBD(§8.4)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---- Embeddings (T-205, FR-ING-03, R-36) ----
# How the worker drives the embeddings endpoint — batching, concurrency, transport.
# Separate from OPENAI_* (provider/account facts shared by chat and the judge).
# `fake` selects the deterministic in-process client for dev/CI; it is never chosen
# implicitly, so a missing key fails loudly instead of ingesting nonsense vectors.
EMBEDDING_BACKEND=openai
# Batch shape is bounded by request count and characters, never by `token_count`
# (R-35(7) — that is a len/4 estimate, and an underestimate is a hard 400). Ceilings
# come from the API's own limits: a 2048-item array, 300k tokens summed per request.
EMBEDDING_MAX_BATCH_SIZE=128
EMBEDDING_MAX_BATCH_CHARS=200000
EMBEDDING_MAX_CONCURRENT_REQUESTS=4
# The SDK default timeout is 600s — inside a worker that is a hang, not a timeout.
# Ingestion can ride out a rate-limit blip; a chat turn (T-206) cannot.
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_TIMEOUT_SECONDS=15
EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_MAX_RETRIES=4
EMBEDDING_QUERY_MAX_RETRIES=1

# ---- Chat completions (T-304 router, T-307 generation; R-45) ----
# How the app drives the chat endpoint. Same split from OPENAI_* as EMBEDDING_*.
# `fake` selects the deterministic in-process client for dev/CI and is never chosen
# implicitly — a missing key fails loudly instead of routing every query with a stub.
LLM_BACKEND=openai
# Generation (T-307). The SDK default is 600s, which on a request path is a hang.
LLM_TIMEOUT_SECONDS=90
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
# The answer ceiling. A *ceiling*, not a target: hitting it truncates the answer, which
# fails the turn closed (R-48(2)) rather than serving half a grounded answer — so it sits
# well above a normal answer instead of trimming one.
LLM_MAX_OUTPUT_TOKENS=1500
# The FR-RET-03 router's own budget — short on purpose. The call sits before retrieval on
# the chat critical path, and R-45(2) makes the router fail open, so waiting is strictly
# worse than giving up and retrieving with `hybrid` (which is what FR-RET-03 prescribes
# for an unclassified query anyway).
LLM_ROUTER_TIMEOUT_SECONDS=8
LLM_ROUTER_MAX_RETRIES=1
# The FR-RET-02 reranker's budget — longer than the router's (it carries whole passages,
# not one query) and shorter than generation's (it is still before the first token, and
# R-47(2) makes it fail open).
LLM_RERANK_TIMEOUT_SECONDS=20
LLM_RERANK_MAX_RETRIES=1
# The FR-EVL-01 judge (T-309, R-50). The most patient budget, and the only one whose
# patience is free: nothing waits on this call, so a slow judge delays a chip, never an
# answer. # TBD(§8.4)
LLM_EVAL_TIMEOUT_SECONDS=60
LLM_EVAL_MAX_RETRIES=2
# Re-judge a chip scoring below this with OPENAI_JUDGE_ESCALATION_MODEL; the second score
# REPLACES the first (never max()). Set 0 to disable escalation entirely — that is the off
# switch, which is why there is no separate EVAL_ESCALATE_ENABLED. Fires on ~28% of messages
# at 0.9, because healthy scores cluster at exactly 1.00.
EVAL_ESCALATE_BELOW=0.9

# ---- Query routing (T-304, FR-RET-03, R-45) ----
# All # TBD(§8.4). Quality and cost knobs: every failure to honour one degrades to
# `hybrid`, never to an error.
# Derived probes IN ADDITION to the original query, which retrieval always searches
# (R-45(3)) — so 3 means at most 4 probes, i.e. 8 arm queries run concurrently.
ROUTER_MAX_SUB_QUERIES=3
# Per-probe ceiling, sized for a HyDE passage. Enforced by truncation, never by dropping
# the probe — discarding it would silently turn `hyde` into `hybrid`.
ROUTER_MAX_PROBE_CHARS=400
# Generous rather than tight: a ceiling that truncates the JSON mid-object produces the
# malformed payload the fail-open path has to throw away, so shaving tokens here costs
# whole classifications and saves nothing.
ROUTER_MAX_OUTPUT_TOKENS=800
# How much conversation tail the router sees, so `vague` follow-ups ("what about the
# second one?") can be rewritten from context instead of guessed at. R-30's untruncated
# history belongs to the generator, not to a classification. 0 disables the read entirely.
ROUTER_HISTORY_TURNS=4
ROUTER_HISTORY_MAX_CHARS=600

# ---- Hybrid retrieval (T-206, R-37) ----
# All # TBD(§8.4). Retrieval-quality knobs, not limits: none of them is an FR-ING-03
# fingerprint input, so all are tunable at zero re-embed cost.
# Per-arm candidate depth, fetched before fusion.
RETRIEVAL_DENSE_CANDIDATES=50
RETRIEVAL_SPARSE_CANDIDATES=50
# Reciprocal Rank Fusion damping. Large enough that one arm's rank-1 hit cannot by
# itself outrank a chunk both arms returned.
RETRIEVAL_RRF_K=60
# What hybrid search returns, per probe — the reranker's input. NOT the FR-RET-02 top-K,
# which counts reranked passages and is RERANK_TOP_K below.
RETRIEVAL_FUSION_TOP_K=30
# Applies per probe (R-46(4)): the T-304 router can fan a turn out over up to
# ROUTER_MAX_SUB_QUERIES + 1 queries, and this is how many candidates survive the merge of
# their ranked lists. Larger than RETRIEVAL_FUSION_TOP_K on purpose — capping the merged set
# at one probe's worth would discard most of the diversity the fan-out paid for.
RETRIEVAL_MERGED_TOP_K=50
# pgvector's default is 40, and an HNSW scan cannot return more neighbours than its
# search list holds — leave this below RETRIEVAL_DENSE_CANDIDATES and the dense arm is
# silently truncated. Enforced by a settings validator.
RETRIEVAL_HNSW_EF_SEARCH=100
# Must match ix_document_chunks_chunk_text_fts, which indexes
# to_tsvector('english', chunk_text). Changing it without a migration that rebuilds
# that index turns every lexical search into a sequential scan — correct answers,
# unusable latency. The validator rejects any other value.
RETRIEVAL_FTS_LANGUAGE=english
# R-35(5) overlap dedupe: adjacent chunks of one block share up to CHUNKER_OVERLAP_CHARS
# and are indexed twice by FTS. A diagnostic kill switch, not a preference.
RETRIEVAL_DEDUPE_ADJACENT=true
# T-311: run the original query's retrieval arm concurrently with the T-304 router call
# instead of after it. Free because R-45(3) makes probes additive — the query is searched on
# every turn whatever the router decides. Off is not a degraded mode; it is the sequential
# timing this release replaced.
RETRIEVAL_PREFETCH_QUERY_ARM=true

# ---- Reranking (T-306, FR-RET-02, R-47) ----
# All # TBD(§8.4). Quality and cost knobs: R-47(2) makes every failure fall back to the
# retrieval order, so nothing here can fail a turn.
# The FR-RET-02 top-K — the passages that become the grounding context. Settle it together
# with RETRIEVAL_MERGED_TOP_K and ROUTER_MAX_SUB_QUERIES; the three bound one budget, and a
# value above the merge ceiling is rejected at boot because it would be a silent no-op.
# 8 × ~2,000-character chunks ≈ 4K tokens of grounding, which R-30 excludes from the 10.4K
# conversation budget and bounds *only* here.
RERANK_TOP_K=8
# Candidates per model call, and how many of those calls run at once. 50 ÷ 5 = 10, so the
# defaults score a full merged set in one concurrent wave. Measured live on gpt-4o-mini over
# 50 candidates: 5/10 → 1,520 ms median, 10/5 → 2,090 ms, 25/2 → 3,579 ms. Smaller batches
# repeat the rubric more often (~14% more prompt tokens) and buy a third of the wall-clock.
RERANK_BATCH_SIZE=5
RERANK_MAX_CONCURRENCY=10
# Per-passage ceiling for scoring only — the full text still reaches generation. The single
# biggest lever on what this stage costs.
RERANK_MAX_PASSAGE_CHARS=1200
# Generous on purpose: a cap that truncates the JSON mid-object produces exactly the
# malformed payload the fail-open path then has to discard.
RERANK_MAX_OUTPUT_TOKENS=400
# The integer scale the model scores on; the FR-CIT-04 hover-card number is score/scale.
RERANK_SCORE_SCALE=10

# ---- LangGraph checkpointer (T-301, FR-PER-01, R-42) ----
# Where per-conversation graph state is persisted. `postgres` uses the SAME database as
# DATABASE_URL above (the DSN is derived from it — there is deliberately no second DSN
# setting). Its four checkpoint* tables are NOT owned by Alembic; provision them once with
#   uv run python -m app.services.checkpointer
# `memory` is dev/CI only and the app refuses to boot with it when ENVIRONMENT=production.
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=8
CHECKPOINTER_POOL_TIMEOUT_SECONDS=10
CHECKPOINTER_CONNECT_TIMEOUT_SECONDS=5
# langgraph ships strict msgpack OFF, which lets a checkpoint payload name a Python
# callable that is imported and executed on load. Our state is scalars only, so strict
# mode costs nothing.
CHECKPOINTER_STRICT_MSGPACK=true

# ---- RAG graph orchestration (T-301, FR-ORC-01/07, R-42) ----
# All # TBD(§8.4).
# The FR-ORC-07 `retry_count` bound. A retry costs a second rerank *and* a second generation
# (~4.6 s) on a turn the user has already waited ~5.3 s through, because NFR-PRF-02 holds the
# stream until the gate passes. Ships at 0 on a measurement (T-308 live): the retry composes
# the rejected answer as a HyDE probe, and the zero-citation trigger in practice yields a
# *decline*, which embeds 0.492 against the answering passage where the query itself scores
# 0.598 — i.e. worse than the query it accompanies. The mechanism ships and is tested, so 1
# is one env var away; values above 1 are refused at boot (the probe is single-shot).
GRAPH_MAX_RETRIES=0
# NOT langgraph's default ("async"), under which a kill can lose the last superstep —
# the exact durability FR-PER-01/NFR-REL-03 are buying.
GRAPH_DURABILITY=sync
GRAPH_NODE_TIMEOUT_SECONDS=120
# Must admit the worst-case path, which grows with GRAPH_MAX_RETRIES; too low turns an
# FR-RET-05 abstention into a GraphRecursionError. Asserted by tests/test_graph.py.
GRAPH_RECURSION_LIMIT=25
# The R-24 processing gate (FR-STA-02 / FR-ORC-04, R-43). Lifetime of the
# `processing_locks` row the graph publishes while a turn runs; must be >=
# GRAPH_NODE_TIMEOUT_SECONDS, since a gate that cannot outlive one node is meaningless.
# The number is a trade, not a default: too short and the gate lifts during a healthy slow
# turn; too long and a crashed run pauses that user's uploads for the whole remainder.
# There is no sweeper — expiry *is* the crash release.
GRAPH_LOCK_TTL_SECONDS=180
# Diagnostic kill switch only. False stops the four mutating document routes answering
# 409; the graph still takes and releases the gate. Never a handling path for a bug.
GRAPH_LOCK_ENFORCED=true
# The T-304 FR-RET-03 router (R-45(2)). Off = every query retrieves with `hybrid`, which
# FR-RET-03 itself prescribes for an unclassified query — so this removes an improvement,
# not a requirement. NOT the failure path: the node already fails open on its own. This is
# for deliberately not paying for the extra model call.
GRAPH_ROUTER_ENABLED=true
# The T-306 FR-RET-02 reranker (R-47). Same kind of switch as the one above and for the same
# reason — the node fails open by itself, so this is only for not paying for the call. Off,
# grounding is the top-K of the retrieval order and no FR-CIT-04 score is published.
GRAPH_RERANK_ENABLED=true
# There is deliberately NO GRAPH_GENERATE_ENABLED and NO GATE_ENABLED (R-48(3)/R-49): the
# three switches above each have a sanctioned off state, and those two would be "no product"
# and "serve unverified answers".

# ---- Groundedness gate (T-308, FR-RET-05/FR-CIT-06, R-49) ----
# All # TBD(§8.4). Policy knobs, not budgets — the gate is a pure function of checkpointed
# state (no chunk read, no model call), so it has no timeout, no retries and no model id.
# The FR-RET-05 groundedness threshold: supported claim sentences ÷ substantive ones, below
# which the turn retries or abstains rather than serving. The decision-relevant boundary is
# 0 vs non-zero — no citations at all is the fabrication signature — so this only decides
# pass-vs-abstain for partially cited answers. Ties are permissive on purpose: a control
# that refuses real questions is worse than no control. If healthy answers ever cluster
# below this, the metric is wrong, not the number.
GATE_MIN_GROUNDEDNESS=0.5
# Words below which a sentence is connective tissue ("In summary:", a bare heading) rather
# than a claim needing a citation. This filter is what keeps the score sane.
GATE_MIN_CLAIM_WORDS=4
# Floor on the retry probe. Below this the rejected answer is too short to retrieve
# differently from the query, so the retry could not help.
GATE_MIN_PROBE_CHARS=40

# ---- Post-hoc evaluation (T-309, FR-EVL-01, R-50) ----
# Scores served answers in the worker and writes messages.evaluation. Two metrics, not the
# four FR-EVL-01 names: Contextual Precision and Contextual Recall are reference-based
# (DeepEval requires expected_output) and a live chat turn has no reference answer, so those
# two live in the offline golden-set harness instead.
#
# Unlike GATE_ENABLED — which deliberately does not exist — this switch is legitimate:
# FR-EVL-01 says a response *may* carry scores, so "no chips" is a state the requirement
# itself sanctions. It is a cost switch, not a failure path. Evaluation fails open: a
# message whose judge never answers keeps evaluation NULL, which is a correct end state.
EVAL_ENABLED=true
# Per-passage ceiling on the context handed to the judge. Five judge calls per message each
# carry the full cited context, so this is the main lever on evaluation cost. # TBD(§8.4)
EVAL_MAX_CONTEXT_CHARS=4000
# There is deliberately NO EVAL_MAX_CONCURRENCY. Across messages that is already
# WORKER_MAX_JOBS, and a second setting governing the same thing is how the two drift apart;
# within a message the fan-out is a fixed two metrics, which is not a pool. Those two run
# sequentially on purpose: the job is post-hoc so its latency is nearly free, and that buys
# lower instantaneous pressure on the key that also serves live turns.
# DeepEval reports usage to its vendor by default. Opting out is the default here because
# the payloads are answers and retrieved passages from a private corpus.
EVAL_TELEMETRY_OPT_OUT=true

# ---- Conversation context window (T-310, FR-STA-04 / NFR-CAP-01, R-30/R-51) ----
# The budget FR-STA-04 blocks on and the FR-ANL-03 card displays. It counts **conversation
# history + the current query only** (R-30): the system prompt and the retrieved chunks are
# excluded and bounded separately by RERANK_TOP_K.
#
# So the model's real prompt_tokens will routinely exceed this number, and that is correct —
# 10.4K is a deliberate *product* limit on how long a chat may run, not a model window. The
# OpenAI models carry far larger ones, so nothing here can cause a provider error.
#
# Counting uses the shared characters/4 estimate in `app/tokens.py`, the same rule the GUI
# must apply pre-submission. There is deliberately NO CONTEXT_ENABLED: its off state would
# remove FR-STA-04 rather than degrade it.
CONTEXT_WINDOW_TOKENS=10400
# Headroom held back for the answer that has not been written yet. Without it a chat just
# under the limit accepts a query, the reply carries it over, and the block fires only on the
# NEXT turn — after the budget was already breached. Must be >= LLM_MAX_OUTPUT_TOKENS (a
# cross-group validator refuses less), because an answer may legitimately run to that
# ceiling. # TBD(§8.4)
CONTEXT_ANSWER_RESERVE_TOKENS=1500

# ---- Keycloak (auth baseline, R-28) ----
# Keycloak's own default is 8080; this dev box runs it on 8081. Keep this in step with
# wherever it actually listens (deployment/keycloak/README.md).
#
# This is the PUBLIC base URL: what a browser uses, and what Keycloak stamps into the `iss`
# claim. It must equal Keycloak's own `KC_HOSTNAME` exactly, path included — Keycloak builds
# that claim from its configuration and not from the URL a request arrived on, so a
# mismatch rejects every token while reporting only an invalid issuer.
KEYCLOAK_SERVER_URL=http://localhost:8080
# How the BACKEND reaches Keycloak, when that differs from the browser's URL (R-82).
# Leave empty for a single-host setup — including native development, where both are
# localhost. Set it when the two readers resolve different names for the same Keycloak,
# as in a container deployment: the browser follows the FR-AUT-11 linking redirect to the
# public origin while the API fetches JWKS, tokens and the admin API from a service name.
# The split is by reader: `iss` and the two browser redirects stay public; JWKS, token,
# logout, admin and broker-token calls come here.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=corpus
KEYCLOAK_CLIENT_ID=corpus-backend
# Regenerate after importing the realm — the committed JSON ships a placeholder.
KEYCLOAK_CLIENT_SECRET=
# master-realm admin — Admin API for realm bootstrap + user mgmt (python-keycloak, T-104)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME

# The live auth tests (T-110, tests/test_auth_live.py) are **skipped unless this is set**,
# on the live-OpenAI convention: they need a running Keycloak with the `corpus` realm
# imported and they mutate it (create/delete a probe user, round-trip the admin password),
# so they must never run by accident. Set it to admin@corpus.local's password.
# `test_realm_artifact_imports_and_works` additionally needs KC_ADMIN_USER/KC_ADMIN_PASSWORD
# in the shell (master-realm credentials), because creating a realm is not something the
# corpus service account may do.
KEYCLOAK_LIVE_ADMIN_PASSWORD=

# ---- Session / refresh cookie (T-509, R-72) ----
# FR-AUT-07's refresh token has exactly ONE channel: this httpOnly cookie. There is
# deliberately no response-body copy — a cookie set beside a body copy protects nothing.
SESSION_REFRESH_COOKIE_NAME=corpus_refresh
# Scoped to the only routes that read it, so it is not attached to every API call.
SESSION_REFRESH_COOKIE_PATH=/api/v1/auth
# Refused at boot when ENVIRONMENT=production (see the top of this file). Browsers treat
# `http://localhost` as a trustworthy origin, so `true` is correct even in local dev — but
# a hostname that merely resolves to loopback (corpus.local, host.docker.internal) is NOT
# trustworthy, and there the cookie is dropped unless you terminate TLS.
SESSION_REFRESH_COOKIE_SECURE=true
# `strict` is what the single-origin deployment buys: the SPA and the API answer on one
# origin behind one reverse proxy, so nothing legitimate is ever a cross-site request.
# `none` without SECURE=true is refused (browsers drop such cookies silently).
SESSION_REFRESH_COOKIE_SAMESITE=strict

# ---- Live document-status channel (T-210, FR-KBM-09) ----
# How often each open SSE connection re-reads document state. This is per connection, so
# it is also the floor this surface puts under database load.
SSE_POLL_INTERVAL_SECONDS=1.5
# When a document is reported `stalled`. LEAVE THIS COMMENTED OUT to derive it from
# WORKER_JOB_TIMEOUT_SECONDS + 60 s, which is the right answer: set below arq's own timeout
# guard, a healthy long ingestion gets flagged as stalled.
# It must be absent, not empty: the field is `float | None`, and an empty string is a
# parse error that stops the app booting ("Input should be a valid number") rather than
# meaning "unset".
# SSE_STALL_AFTER_SECONDS=960
# Per USER, not per tab — every stream is a recurring query.
SSE_MAX_STREAMS_PER_USER=4

# ---- Telemetry (T-604, NFR-OBS-01/04, R-79) ----
# Retention horizon for `turn_telemetry`, in days. NOTE THE POLARITY: 0 means KEEP FOREVER,
# the opposite of CHECKPOINTER_RETENTION_INTERVAL_SECONDS below, where 0 disables the sweep.
# Read as a horizon, "older than 0 days" would mean "delete everything".
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_RETENTION_BATCH=5000
# How often the retention cron runs. 0 disables it.
TELEMETRY_RETENTION_INTERVAL_SECONDS=86400
# OpenTelemetry span emission, one span per closed turn. Off by default: the SDK is present
# transitively, so an operator running `opentelemetry-instrument` would otherwise start
# exporting without having asked. Configure the exporter with the usual OTEL_* variables.
TELEMETRY_TRACING_ENABLED=false

# ---- Cloud drive import (T-214, FR-KBM-10 / FR-AUT-11, R-63) ----
# Corpus stores NO third-party credential: the Drive token is held by Keycloak and read
# through its broker endpoint. The Google client id/secret belong in the realm, not here.
CLOUD_API_BASE=https://www.googleapis.com
# Where Keycloak returns the browser after the account-link legs. Both MUST match this
# deployment's real origins, or linking dead-ends on a redirect the realm will not accept.
CLOUD_CALLBACK_BASE_URL=http://localhost:8000
CLOUD_RETURN_URL=http://localhost:5173/
CLOUD_LINK_STATE_TTL_SECONDS=600
CLOUD_LIST_PAGE_SIZE=50
CLOUD_MAX_LIST_PAGE_SIZE=200
CLOUD_TIMEOUT_SECONDS=30

# ---- Checkpoint retention (R-65) ----
# Keep the newest N checkpoints per thread. Only the latest is ever read; the rest is margin.
CHECKPOINTER_RETENTION_KEEP=3
# The load-bearing guard: never touch a checkpoint younger than this, so a burst of
# supersteps cannot evict the checkpoint a live turn is about to resume from.
CHECKPOINTER_RETENTION_MIN_AGE_SECONDS=3600
CHECKPOINTER_RETENTION_ORPHAN_BATCH=500
# How often the prune cron runs. 0 disables it (contrast TELEMETRY_RETENTION_DAYS above).
CHECKPOINTER_RETENTION_INTERVAL_SECONDS=3600

# ---- Prompt-injection screen (T-303, NFR-SEC-05, R-44) ----
# Switchable ONLY because the structural controls it backs up — one instructions-only
# system message, untrusted text fenced and neutralised, the query last — have no flag and
# must never get one. Turning this off does not make the prompt injectable; it removes the
# query-level screen in front of it.
GRAPH_SCREEN_ENABLED=true

# ---- Keycloak identity brokering for cloud import (T-214, R-63) ----
# The second client, used for nothing but the FR-AUT-11 account-link redirect: it is the
# only one with standardFlow enabled, because ROPC has no browser and brokering needs one.
# Keep R-63(3)'s link-only posture in the realm, or brokering becomes a signup route that
# FR-USR-02/03 forbids.
KEYCLOAK_LINKING_CLIENT_ID=corpus-linking
# Alias of the identity provider in the realm; also the path segment in the broker token
# endpoint the backend reads the Drive token from.
KEYCLOAK_GOOGLE_IDP_ALIAS=google

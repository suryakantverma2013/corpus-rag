# Corpus backend configuration template (T-005). Copy to `.env` and fill in
# secrets:  cp backend/.env.example backend/.env
# `.env` is gitignored; this template is tracked. Defaults align with
# deployment/docker-compose.yml so the app boots with minimal edits.

# ---- Postgres ----
# Async DSN the app uses (developer's local pgvector-enabled `corpus` database).
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/corpus
# Individual vars — used by the compose `postgres` profile only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corpus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# ---- Object storage (T-201, R-19) ----
# Backend: `s3` (MinIO or AWS S3) or `local` (filesystem; dev only, R-19).
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=.data/objects
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_TIMEOUT_SECONDS=30

# ---- MinIO / S3 connection (used when STORAGE_BACKEND=s3) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=corpus
MINIO_SECURE=false
# Signing region. MinIO ignores it; botocore requires one.
MINIO_REGION=us-east-1

# ---- Uploads (T-202, FR-ERR-01/02/03) ----
# 50 MB/file and 10 GB/user are spec-normative (R-11); only the rejection copy is TBD.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_USER_QUOTA_BYTES=10737418240
UPLOAD_ENFORCE_QUOTA=true
UPLOAD_READ_CHUNK_BYTES=1048576
UPLOAD_SNIFF_HEAD_BYTES=8192
UPLOAD_MAX_CONCURRENT=8

# ---- Parsers (T-203, R-31(3) decompression caps) ----
# Worker-side ceilings on what a parser may expand an accepted original into.
# A breach fails the document (CONTENT_LIMIT_EXCEEDED); nothing is ever truncated.
PARSER_MAX_PAGES=5000
PARSER_MAX_EXTRACTED_CHARS=20000000
PARSER_MAX_BLOCK_CHARS=200000
PARSER_DOCX_MAX_EXPANDED_BYTES=419430400
PARSER_DOCX_MAX_COMPRESSION_RATIO=200
PARSER_DOCX_MAX_MEMBERS=5000
PARSER_CSV_MAX_ROWS=200000
PARSER_CSV_MAX_COLUMNS=1000
PARSER_CSV_ROWS_PER_BLOCK=50

# ---- Chunker (T-204, FR-ING-03, R-35) ----
# Retrieval-quality knobs, not limits — nothing here fails a document. All four
# compose into `chunking_version`, so changing any of them re-embeds the affected
# corpus on next ingestion (that is FR-ING-03 working, but it costs money).
CHUNKER_TARGET_CHARS=2000
CHUNKER_OVERLAP_CHARS=200
CHUNKER_MIN_CHARS=200
CHUNKER_BOUNDARY_FLOOR_RATIO=0.5

# ---- Redis (arq broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Background job queue (T-202 seam; worker is T-207) ----
# `arq` enqueues to Redis; `none` is a no-op for dev/CI without Redis.
QUEUE_BACKEND=arq
QUEUE_ENQUEUE_TIMEOUT_SECONDS=5

# ---- Rate limiting (slowapi, T-105, NFR-SEC-07) ----
# Prod uses Redis so limits are shared across workers; a distinct DB index (/1)
# keeps keys clear of the arq broker on /0. Tests force memory://. slowapi hits
# storage synchronously, so this must be the sync `redis://` scheme.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
# Provisional thresholds — # TBD(§8.4). login/refresh key per-IP; the rest per-user.
RATELIMIT_LOGIN=10/minute
RATELIMIT_REFRESH=30/minute
RATELIMIT_CHANGE_PASSWORD=5/minute
RATELIMIT_CHAT=20/minute
RATELIMIT_UPLOAD=20/minute

# ---- OpenAI (R-15) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
# Must stay 3072-dimensional to match `document_chunks.embedding` VECTOR(3072)
# (app.db.base.EMBEDDING_DIM). text-embedding-3-small is 1536-dim and will fail on
# insert. The model name is also an FR-ING-03 fingerprint input — changing it
# re-embeds the corpus. # TBD(§8.4)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---- Embeddings (T-205, FR-ING-03, R-36) ----
# How the worker drives the embeddings endpoint — batching, concurrency, transport.
# Separate from OPENAI_* (provider/account facts shared by chat and the judge).
# `fake` selects the deterministic in-process client for dev/CI; it is never chosen
# implicitly, so a missing key fails loudly instead of ingesting nonsense vectors.
EMBEDDING_BACKEND=openai
# Batch shape is bounded by request count and characters, never by `token_count`
# (R-35(7) — that is a len/4 estimate, and an underestimate is a hard 400). Ceilings
# come from the API's own limits: a 2048-item array, 300k tokens summed per request.
EMBEDDING_MAX_BATCH_SIZE=128
EMBEDDING_MAX_BATCH_CHARS=200000
EMBEDDING_MAX_CONCURRENT_REQUESTS=4
# The SDK default timeout is 600s — inside a worker that is a hang, not a timeout.
# Ingestion can ride out a rate-limit blip; a chat turn (T-206) cannot.
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_TIMEOUT_SECONDS=15
EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_MAX_RETRIES=4
EMBEDDING_QUERY_MAX_RETRIES=1

# ---- Keycloak (auth baseline, R-28) ----
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=corpus
KEYCLOAK_CLIENT_ID=corpus-backend
KEYCLOAK_CLIENT_SECRET=
# master-realm admin — Admin API for realm bootstrap + user mgmt (python-keycloak, T-104)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
